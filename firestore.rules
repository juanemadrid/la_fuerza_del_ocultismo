rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ──────────────────────────────────────────────────────────────

    // Verifica si el usuario está autenticado
    function isAuth() {
      return request.auth != null;
    }

    // Verifica si el usuario es admin
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/user/$(request.auth.uid)).data.role == 'admin';
    }

    // Verifica si el usuario tiene membresía activa
    function isSubscribed() {
      return isAuth() &&
        get(/databases/$(database)/documents/user/$(request.auth.uid)).data.isSubscribed == true;
    }

    // Verifica si el doc pertenece al usuario autenticado
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─── USUARIOS ─────────────────────────────────────────────────────────────
    match /user/{uid} {
      // Cada usuario solo lee su propio perfil. Admins leen todos.
      allow read: if isOwner(uid) || isAdmin();

      // Crear perfil (registro): siempre como usuario normal, sin membresía.
      // Nadie puede registrarse directamente como admin ni como premium.
      allow create: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.get('role', 'user') == 'user' &&
        request.resource.data.get('isSubscribed', false) == false &&
        request.resource.data.get('subscriptionExpiry', null) == null
      );

      // El admin puede editar cualquier campo (roles, suscripciones).
      // El usuario solo edita sus datos: nunca su rol ni la fecha de vencimiento,
      // y la membresía solo la puede apagar (cuando vence), nunca activarla.
      allow update: if isAdmin() || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'subscriptionExpiry']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSubscribed']) ||
          request.resource.data.isSubscribed == false
        )
      );

      // Solo el admin puede eliminar usuarios
      allow delete: if isAdmin();
    }

    // ─── CONTENIDO (Rituales, Limpiezas, PDFs) ────────────────────────────────
    match /content/{docId} {
      // Solo usuarios suscritos o admins pueden ver el contenido
      allow read: if isSubscribed() || isAdmin();

      // Solo admins pueden crear, editar o eliminar contenido
      allow write: if isAdmin();
    }

    // ─── HORÓSCOPO ────────────────────────────────────────────────────────────
    match /horoscopes/{sign} {
      // Cualquier usuario autenticado puede ver el horóscopo
      allow read: if isAuth() || isAdmin();

      // Solo admins pueden actualizar el horóscopo
      allow write: if isAdmin();
    }

    // ─── RITUALES ─────────────────────────────────────────────────────────────
    match /rituales/{docId} {
      allow read: if isSubscribed() || isAdmin();
      allow write: if isAdmin();
    }

    // ─── LIMPIEZAS ────────────────────────────────────────────────────────────
    match /limpiezas/{docId} {
      allow read: if isSubscribed() || isAdmin();
      allow write: if isAdmin();
    }

    // ─── TAROT ────────────────────────────────────────────────────────────────
    match /tarot_cards/{docId} {
      allow read: if isAuth() || isAdmin();
      allow write: if isAdmin();
    }

    // ─── PLANES DE MEMBRESÍA ──────────────────────────────────────────────────
    // Los planes son públicos (cualquiera puede ver los precios para registrarse)
    match /planes/{docId} {
      allow read: if true;  // Público - necesario para la pantalla de selección de plan
      allow write: if isAdmin();
    }

    // ─── CONFIGURACIÓN GENERAL ────────────────────────────────────────────────
    match /config/{docId} {
      // El link de WhatsApp es público (se usa antes de iniciar sesión).
      // El resto de la configuración (incluida la clave de IA) solo la leen
      // usuarios con sesión iniciada; antes la podía leer cualquiera en internet.
      allow read: if docId == 'whatsapp' || isAuth();

      // Solo admins pueden modificar la configuración
      allow write: if isAdmin();
    }

    // ─── BLOQUEAR TODO LO DEMÁS ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
